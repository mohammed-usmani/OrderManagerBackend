# --- Required ---------------------------------------------------------------
# Matches `docker compose up -d db redis` (Postgres :5433, Redis :6380).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/restaurant
JWT_SECRET_KEY=change-me-to-a-random-32-char-secret
ADMIN_EMAIL=admin@saffronandsmoke.com
ADMIN_PASSWORD=changeme123

# Voice: Gemini Live native audio (Google AI Studio key).
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# --- Optional ---------------------------------------------------------------
REDIS_URL=redis://localhost:6380
JWT_EXPIRE_DAYS=7

# Browser session cookie. Production: CORS_ORIGINS=https://order-manager.mohammedusmani.me
CORS_ORIGINS=http://localhost:3000
# Local plain-http development only; keep true (the default) in production.
AUTH_COOKIE_SECURE=false

# Behind a reverse proxy: its address/range, so per-IP rate limits see real callers.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Seed an empty database on startup; set false once a deployment is set up.
SEED_ON_STARTUP=true

# Gemini Live model and voice (defaults shown).
GEMINI_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_VOICE=Charon

# Voice line limits: concurrent calls (Gemini free tier ~3) and max call length.
MAX_CONCURRENT_CALLS=3
MAX_SESSION_SECONDS=900
# End a call when nobody has spoken for this many seconds.
VOICE_IDLE_SECONDS=90

# Semantic menu search (pgvector). Without a key, search is keyword-only.
MISTRAL_API_KEY=
MISTRAL_EMBED_MODEL=mistral-embed
EMBEDDING_DIM=1024

# Razorpay test mode. Leave empty for cash-only payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Menu photo uploads. Leave empty and admins paste image URLs instead.
CLOUDINARY_URL=
